{
	"name": "pppr",
	"version": "0.0.3",
	"private": true,
	"description": "A minimal terminal testing rig for agentic tools, powered by Pi",
	"type": "module",
	"bin": {
		"pppr": "dist/cli.js"
	},
	"scripts": {
		"start": "node --import tsx src/cli.ts",
		"build": "tsgo -p tsconfig.build.json",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit",
		"test": "vitest --run"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@mariozechner/pi-agent-core": "0.57.1",
		"@mariozechner/pi-ai": "0.57.1",
		"@mariozechner/pi-coding-agent": "0.57.1",
		"@sinclair/typebox": "^0.34.41"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"tsx": "^4.20.3",
		"vitest": "^3.2.4"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"fast-xml-parser": "5.3.8",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
